# Release settings, read by tools/release.sh (public values only; the private keys stay in the keychain).
# EdDSA public key for Sparkle; its private half is in the login keychain ("Private key for signing Sparkle updates"),
# back it up with: app/.build/artifacts/sparkle/Sparkle/bin/generate_keys -x <file>
OCTOMUX_ED_PUBLIC_KEY=blzQkSu4ngv5216Nj5llmYPsQs9ES33IL4lY6yl31Wg=
# GitHub repo the releases live on. The appcast is an asset of the latest release; each update zip is an asset
# of its own release (tag v<version>), so tools/release.sh derives the download prefix from VERSION.
OCTOMUX_GITHUB_REPO=anilsenay/octomux
OCTOMUX_FEED_URL=https://github.com/anilsenay/octomux/releases/latest/download/appcast.xml
# Homebrew tap the publish step writes the cask into (brew install --cask anilsenay/tap/octomux).
OCTOMUX_HOMEBREW_TAP=anilsenay/homebrew-tap
