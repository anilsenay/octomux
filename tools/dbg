#!/usr/bin/env python3
"""Talks to the app's debug socket: dbg <method> [json-params]"""
import json, os, socket, sys
support = os.path.expanduser("~/Library/Application Support")
home = os.environ.get("OCTOMUX_HOME") or os.environ.get("ADE_HOME") or (
    os.path.join(support, "Octomux") if os.path.isdir(os.path.join(support, "Octomux")) or not os.path.isdir(os.path.join(support, "ade-dev"))
    else os.path.join(support, "ade-dev"))
s = socket.socket(socket.AF_UNIX); s.connect(os.path.join(home, "run/app-debug.sock"))
params = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
s.sendall((json.dumps({"method": sys.argv[1], "params": params}) + "\n").encode())
buf = b""
while not buf.endswith(b"\n"):
    c = s.recv(65536)
    if not c: break
    buf += c
r = json.loads(buf)
if "error" in r: print("ERROR:", r["error"]); sys.exit(1)
v = r["result"]
print(v if isinstance(v, str) else json.dumps(v, indent=1, ensure_ascii=False))
